DATABASE_URL=mysql://root:root@127.0.0.1:3306/notification_center
# DB_NAME overrides the database in DATABASE_URL/DATABASE_READER_URL (one DB per worktree)
# DB_NAME=nc_local
# `npm test` defaults DATABASE_URL to the compose server above and DB_NAME to notification_center_test when unset.
# RESOURCE_NAMESPACE defaults to the resolved database name (used for server-wide names e.g. GET_LOCK)
ASSET_BASE_URL=https://assets.example.com
SITE_BASE_URL=https://www.example.com
STANDINS=true
